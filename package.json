{
  "name": "@eversko/dsh-blackbox",
  "version": "0.1.2",
  "description": "Privacy-safe flight recorder, anomaly detector, and shareable incident pack for DeepSeek Harness sessions.",
  "type": "module",
  "types": "./src/index.d.mts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./analyzer": {
      "types": "./src/analyzer.d.mts",
      "import": "./src/analyzer.mjs"
    },
    "./artifact": {
      "types": "./src/artifact.d.mts",
      "import": "./src/artifact.mjs"
    },
    "./pack": {
      "types": "./src/pack.d.mts",
      "import": "./src/pack.mjs"
    },
    "./plugin": {
      "types": "./src/plugin.d.mts",
      "import": "./src/plugin.mjs"
    },
    "./schema": "./schemas/dshpack.schema.json"
  },
  "bin": {
    "dsh-blackbox": "bin/dsh-blackbox.mjs"
  },
  "files": [
    "bin",
    "schemas",
    "src",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs && npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "node tests/demo.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent-observability",
    "incident-reproduction",
    "privacy"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19 <23"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "typescript": "5.7.3"
  },
  "license": "MIT",
  "author": "Eversko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eversko/dsh-blackbox.git"
  },
  "homepage": "https://github.com/eversko/dsh-blackbox#readme",
  "bugs": {
    "url": "https://github.com/eversko/dsh-blackbox/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "npm@10.9.2"
}
